# Copy to .env and fill in. NEVER commit .env.
TL_ENV=production
TL_SECRET_KEY=            # required: >=32 random chars  (python -c "import secrets;print(secrets.token_urlsafe(48))")
TL_COOKIE_SECURE=true     # true behind HTTPS
TL_CORS_ORIGINS=https://your-frontend.example
TL_FRONTEND_URL=https://your-frontend.example
POSTGRES_PASSWORD=        # required for docker compose
TL_DATABASE_URL=postgresql+psycopg://truthlens:${POSTGRES_PASSWORD}@postgres:5432/truthlens
TL_REDIS_URL=redis://redis:6379/0
# Model (review license first: docs/MODEL_SETUP.md)
TL_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
TL_MODEL_REVISION=main    # pin a commit hash for reproducibility
TL_DEVICE=auto            # auto | cpu | cuda
# Limits
TL_MAX_UPLOAD_MB=200
TL_MAX_DURATION_SECONDS=300
TL_RETENTION_DAYS=7
# Email (SMTP) - required in production for verification/reset emails
TL_SMTP_HOST=
TL_SMTP_PORT=587
TL_SMTP_USER=
TL_SMTP_PASSWORD=
TL_MAIL_FROM=TruthLens AI <no-reply@your-domain.example>
# Optional Google OAuth
TL_GOOGLE_CLIENT_ID=
TL_GOOGLE_CLIENT_SECRET=
# Optional audio model (not required)
TL_ENABLE_AUDIO=false
TL_AUDIO_MODEL_ID=
